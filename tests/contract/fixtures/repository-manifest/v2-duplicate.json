{
  "apiVersion": "takosumi.com/v2",
  "kind": "Repository",
  "install": {
    "modules": {
      ".": {
        "inputs": [],
        "interfaces": [
          {
            "key": "launcher",
            "name": "example.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {"launcher": true},
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "url"
                }
              },
              "access": {"visibility": "workspace"}
            }
          },
          {
            "key": "another",
            "name": "another.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {"launcher": true},
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "string"
                }
              },
              "access": {"visibility": "workspace"}
            }
          }
        ]
      }
    }
  }
}
