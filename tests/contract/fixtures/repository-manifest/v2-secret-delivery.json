{
  "apiVersion": "takosumi.com/v2",
  "kind": "Repository",
  "install": {
    "modules": {
      ".": {
        "inputs": [],
        "interfaces": [
          {
            "key": "launcher",
            "name": "example.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {"launcher": true},
              "access": {"visibility": "workspace"}
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {"source": "installing_principal"},
                "permissions": ["ui.open"],
                "delivery": {
                  "type": "none",
                  "credentialRef": "secret/should-not-be-here"
                }
              }
            ]
          }
        ]
      }
    }
  }
}
