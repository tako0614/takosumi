{
  "name": "@takosjp/takosumi",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "takosumi": "cli/src/main.ts"
  },
  "workspaces": [
    "contract",
    "accounts/contract",
    "accounts/service",
    "cli",
    "deploy/node-postgres"
  ],
  "scripts": {
    "wrangler": "wrangler",
    "check": "bun scripts/check-portable-gate.ts",
    "fmt:check": "bun scripts/check-source-format.mjs",
    "deploy": "bun scripts/deploy.mjs",
    "check:package-script-boundaries": "bun scripts/check-package-script-boundaries.ts",
    "check:production-migrations": "bun scripts/check-production-migration-boundary.ts",
    "check:no-first-party-provider": "bun scripts/check-no-first-party-provider.ts",
    "check:platform-bindings": "bun scripts/check-platform-bindings.ts --check",
    "check:authoritative-docs": "bun scripts/check-authoritative-doc-boundaries.ts",
    "check:generalization-boundaries": "bun scripts/check-generalization-boundaries.ts",
    "check:import-boundaries": "bun scripts/check-import-boundaries.ts",
    "check:test-source-boundary": "bun scripts/check-test-source-boundary.ts",
    "check:dashboard": "(cd dashboard && bunx tsc --noEmit --pretty false -p tsconfig.json && bun run build) && bash scripts/build-app-docs.sh && bun scripts/check-dashboard-data-free-assets.ts",
    "check:dashboard-browser": "bun run test:dashboard-browser-harness && bun scripts/run-dashboard-browser-e2e.ts portable",
    "check:worker-types": "tsc --noEmit -p tsconfig.worker.json",
    "check:cloudflare-worker-build": "bun build --target browser --format esm --external cloudflare:workers deploy/platform/entry-worker.ts --outfile /tmp/takosumi-platform-worker-check.mjs && bun scripts/assert-worker-schema-bundle.ts /tmp/takosumi-platform-worker-check.mjs",
    "test": "bun run test:workerd && bun test --only-failures ./tests --path-ignore-patterns=tests/dashboard/e2e/** --path-ignore-patterns=tests/runner/compatibility_check_test.ts --path-ignore-patterns=tests/core/domains/deploy-control/capsule_execution_authority_test.ts",
    "test:workerd": "bun test --isolate tests/runner/compatibility_check_test.ts tests/core/domains/deploy-control/capsule_execution_authority_test.ts",
    "test:service": "bun test ./tests/core",
    "test:accounts": "bun test ./tests/accounts ./tests/deploy/node-postgres ./tests/deploy/accounts-cloudflare",
    "test:cli": "bun test ./tests/cli",
    "test:control-d1-schema": "bun test tests/deploy/platform/control_d1_schema_test.ts tests/deploy/platform/control_d1_release_capability_test.ts tests/worker/src/d1_opentofu_store_schema_boot_test.ts tests/core/adapters/storage/drizzle/schema/schema_mirror_test.ts",
    "test:dashboard-new-flow": "bun test tests/dashboard/src/views/new/provider-connections-return_test.ts tests/dashboard/src/views/new/new-flow-guidance_test.ts",
    "dashboard:e2e:live": "bun scripts/run-dashboard-browser-e2e.ts live",
    "dashboard:e2e:public-live": "bun scripts/run-dashboard-browser-e2e.ts public-live",
    "test:dashboard-browser-harness": "bun test tests/dashboard/e2e/harness_test.ts",
    "test:critical-journeys": "bun scripts/run-critical-journeys.ts",
    "test:scripts": "bun test ./tests/scripts",
    "check:runner-image-release": "bun test tests/scripts/runner_image_release_test.ts tests/scripts/runner_image_release_authority_test.ts tests/scripts/platform_worker_release_test.ts tests/scripts/platform_worker_release_authority_test.ts tests/scripts/runner_image_release_boundary_test.ts tests/scripts/deploy_entrypoint_boundary_test.ts",
    "audit:public-sites": "(cd docs && npm audit --audit-level=moderate) && (cd website && npm audit --audit-level=moderate)",
    "schema-validators:assets": "bun scripts/build-schema-validators.ts",
    "schema-validators:check": "bun scripts/build-schema-validators.ts --check",
    "credential-recipes:assets": "bun scripts/build-credential-recipe-assets.ts",
    "credential-recipes:check": "bun scripts/build-credential-recipe-assets.ts --check",
    "generated-assets:write": "bun run credential-recipes:assets && bun run schema-validators:assets",
    "generated-assets:check": "bun run generated-assets:wiring:check && bun run credential-recipes:check && bun run schema-validators:check",
    "generated-assets:wiring:check": "bun scripts/check-generated-asset-wiring.ts",
    "operator:release-activator": "bun scripts/operator-release-activator.ts",
    "opentofu:output-proof": "bun tests/proofs/opentofu-output-proof.ts",
    "opentofu:live-local-proof": "bun tests/proofs/live-opentofu-plan-apply.ts",
    "smoke:cloudflare": "bun scripts/smoke-cloudflare.ts",
    "smoke:platform-control-plane": "bun scripts/smoke-platform-control-plane.ts",
    "probe:accounts-rate-limit": "bun scripts/probe-accounts-rate-limit.ts",
    "release-activation:evidence": "bun scripts/validate-release-activation-evidence.ts",
    "production-hardening:evidence": "bun scripts/validate-production-hardening-evidence.ts",
    "production-hardening:gates": "bun scripts/verify-production-hardening-gates.ts",
    "self-host:migration": "bun scripts/self-host-migration.ts",
    "self-host:migration:self-test": "bun scripts/self-host-migration.ts self-test",
    "control-d1-schema:plan": "bun scripts/control-d1-schema.ts plan",
    "control-d1-schema:apply": "bun scripts/control-d1-schema.ts apply",
    "control-d1-schema:fence": "bun scripts/control-d1-schema.ts fence",
    "control-d1-schema:verify": "bun scripts/control-d1-schema.ts verify",
    "control-d1-schema:release-capability": "bun scripts/control-d1-schema.ts release-capability",
    "db:migrate": "bun core/scripts/db-migrate.ts",
    "db:migrate:dry-run": "bun core/scripts/db-migrate.ts --dry-run",
    "db:drizzle:generate:d1": "drizzle-kit generate --config drizzle.config.d1.ts",
    "db:drizzle:generate:postgres": "drizzle-kit generate --config drizzle.config.postgres.ts",
    "accounts": "bun cli/src/main.ts",
    "cli": "bun cli/src/main.ts",
    "docs:build": "cd docs && bun run build",
    "docs:test:browser": "bun run docs:build && bunx --no-install playwright test docs/.vitepress/tests/mobile-navigation_test.ts --config=docs/.vitepress/playwright.config.ts",
    "app-docs:build": "bash scripts/build-app-docs.sh",
    "app-docs:dev": "cd app-docs && ../docs/node_modules/.bin/vitepress dev --host 0.0.0.0",
    "docs:build:all": "bun run docs:build && bun run app-docs:build",
    "docs:dev": "cd docs && bun run dev",
    "website:build": "bash website/build.sh",
    "website:preview": "cd website && bun run preview",
    "website:deploy": "bun scripts/deploy.mjs takosumi-website"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/containers": "^0.3.6",
    "age-encryption": "^0.3.0",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "pg": "^8.11.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@playwright/test": "1.55.1",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "ajv": "8.18.0",
    "drizzle-kit": "^0.31.10",
    "miniflare": "4.20260710.0",
    "typescript": "^5.7.0",
    "wrangler": "4.111.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "ws": "8.21.0"
  }
}
